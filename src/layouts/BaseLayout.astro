---
interface Props {
  title?: string;
}

const { title = 'make sounds' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/global.css" />
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script is:inline>
      (function() {
        var t = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', t);
        var o = localStorage.getItem('cover-overlay') || 'none';
        document.documentElement.setAttribute('data-cover-overlay', o);
      })();
    </script>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="site-name">make sounds</a>
        <div class="nav-links">
          <a href="/tags">tags</a>
          <a href="/admin" target="_blank" rel="noopener">cms</a>
          <div class="theme-switcher">
            <button class="theme-btn" data-set-theme="dark" style="--btn-surface:#333;--btn-accent:#91e5ff" title="Dark"></button>
            <button class="theme-btn" data-set-theme="purple" style="--btn-surface:#340a2e;--btn-accent:#ffb778" title="Purple Blaze"></button>
            <button class="theme-btn" data-set-theme="rose" style="--btn-surface:#0a2e58;--btn-accent:#FF204E" title="Neon Rose"></button>
            <button class="theme-btn" data-set-theme="bonfire" style="--btn-surface:#222;--btn-accent:#E3651D" title="Bonfire"></button>
            <button class="theme-btn" data-set-theme="dusk" style="--btn-surface:#354e60;--btn-accent:#A76F6F" title="Dusk"></button>
            <button class="theme-btn" data-set-theme="banana" style="--btn-surface:#574731;--btn-accent:#ffa149" title="Banana"></button>
            <button class="theme-btn" data-set-theme="light" style="--btn-surface:#fff;--btn-accent:#db4848" title="Light"></button>
          </div>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <script is:inline>
      // Redirect invite/recovery tokens to admin page where the widget can handle them
      if (window.location.hash.match(/#invite_token=|#recovery_token=|#confirmation_token=/)) {
        window.location.href = '/admin/index.html' + window.location.hash;
      }
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', (user) => {
          if (!user) {
            window.netlifyIdentity.on('login', () => {
              document.location.href = '/admin/index.html';
            });
          }
        });
      }

      // Theme switcher
      (function() {
        var current = localStorage.getItem('theme') || 'dark';
        var buttons = document.querySelectorAll('.theme-btn');
        buttons.forEach(function(btn) {
          if (btn.dataset.setTheme === current) btn.classList.add('active');
          btn.addEventListener('click', function() {
            var theme = this.dataset.setTheme;
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
            buttons.forEach(function(b) { b.classList.remove('active'); });
            this.classList.add('active');
          });
        });
      })();
    </script>
  </body>
</html>
