---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import WavePlayer from '../../components/WavePlayer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);
const { title, date, author, tags, cover_image, audio_file } = post.data;

const relatedPosts = allPosts.filter(
  (p) => p.id !== post.id && p.data.tags?.some((tag) => tags?.includes(tag))
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`${title} — make sounds`}>
  <article class="post">
    <header class="post-header">
      <div class="post-header-top">
        {cover_image && (
          <div class="post-header-image">
            <img src={cover_image} alt={title} />
          </div>
        )}

        <div class="post-header-info">
          <h1>{title}</h1>

          <div class="post-meta">
            <span class="author">{author}</span>
            <time datetime={date.toISOString()}>{formattedDate}</time>
            <TagList tags={tags} />
          </div>
        </div>
      </div>

      {audio_file && <WavePlayer src={audio_file} />}

      <div class="post-body">
        <Content />
      </div>
    </header>
  </article>

  {relatedPosts.length > 0 && (
    <section class="related-posts">
      <h2>Entries from this challenge</h2>
      <ul>
        {relatedPosts.map((p) => (
          <li>
            <a href={`/posts/${p.id}`} class="related-post-link">
              {p.data.cover_image
                ? <img src={p.data.cover_image} alt={p.data.title} class="related-post-img" />
                : <div class="related-post-img related-post-placeholder"></div>
              }
              <span class="related-post-title">{p.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <script is:inline>
    (function () {
      var cycle = ['none', '2', '1'];
      function initOverlayToggle() {
        document.querySelectorAll('.post-header-image').forEach(function (el) {
          if (el.dataset.overlayInit) return;
          el.dataset.overlayInit = 'true';
          el.addEventListener('click', function () {
            var current = document.documentElement.getAttribute('data-cover-overlay') || 'none';
            var next = cycle[(cycle.indexOf(current) + 1) % cycle.length];
            document.documentElement.setAttribute('data-cover-overlay', next);
            localStorage.setItem('cover-overlay', next);
          });
        });
      }
      initOverlayToggle();
      document.addEventListener('astro:page-load', initOverlayToggle);
    })();
  </script>
</BaseLayout>
